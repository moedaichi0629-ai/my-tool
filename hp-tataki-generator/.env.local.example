# Google Cloud ConsoleでPlaces APIを有効化して取得したAPIキー
GOOGLE_PLACES_API_KEY=

# OpenAI Platformで取得したAPIキー
OPENAI_API_KEY=

# 使用するOpenAIモデル（省略時は gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# 店舗名・GoogleマップURLの保存先スプレッドシートのID（URLの/d/と/editの間の文字列）
GOOGLE_SHEETS_SPREADSHEET_ID=

# ローカル実行の場合: Google CloudでダウンロードしたサービスアカウントのJSONキーファイルを
# プロジェクト直下に置き、そのファイル名（相対パス）を指定
GOOGLE_SHEETS_CREDENTIALS_FILE=google-sheets-credentials.json

# Vercelなどファイルを配置できない環境の場合: JSONキーファイルの中身をそのまま1行で貼り付け
# （GOOGLE_SHEETS_CREDENTIALS_FILEより優先されます。両方設定する必要はありません）
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
